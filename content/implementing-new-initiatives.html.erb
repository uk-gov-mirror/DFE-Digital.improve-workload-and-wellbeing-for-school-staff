---
title: Implementing new initiatives
---

<div class="dfe-content-page--header dfe-content-page--header--secondary">
  <div class="dfe-width-container">
    <div class="govuk-grid-row govuk-!-padding-top-9 govuk-!-padding-bottom-0">
      <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l govuk-!-margin-bottom-4">Implementing new initiatives</h1>
        <p>
          Access resources and case studies to help you implement new initiatives while minimising the impact on staff workload and wellbeing
        </p>
      </div>
      <div class="govuk-grid-column-one-third">
        <img src="<%= @base_url %>/assets/images/implementing-new-initiatives-hero.jpg"
          alt="A teacher holding a tablet with children interacting with said tablet" class="dfe-hero-image">
      </div>
    </div>
  </div>
</div>

<div class="govuk-main-wrapper">
  <div class="dfe-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full grid grid-template-columns-mobile-1 grid-template-columns-tablet-2">
        <%= render('/partials/tile.*',
          title: "Free breakfast clubs programme",
          body: "Use these resources to support you in setting up a free breakfast club ",
          href: "#{@base_url}/implementing-new-initiatives/free-breakfast-clubs-programme",
          colour: "green"
        ) %>
      </div>
    </div>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <hr class="govuk-section-break--visible govuk-!-margin-bottom-9">
        <%= render '/partials/feedback.*' %>
      </div>
    </div>
  </div>
</div>
